{
  "name": "clairic-test",
  "version": "0.1.0",
  "private": true,
  "description": "Test harness for Cloudflare's Clairic extraction model on Workers AI",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "cases": "node scripts/run-rest.ts",
    "build:receipt": "node scripts/make-receipt.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "wrangler": "^4.152.0"
  }
}
